# Database connection (MySQL / MariaDB / Laragon / XAMPP)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/warkop_agam_db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Autentikasi & Keamanan (RBAC) - JWT Secret Key
JWT_SECRET="warkop-agam-secret-jwt-key-2026-msbd-tubes"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Email Verification (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_16_digit_app_password"
SMTP_FROM="Warkop Agam <your_email@gmail.com>"

# Midtrans Payment Gateway (Sandbox)
MIDTRANS_MERCHANT_ID="your_midtrans_merchant_id_here"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your_client_key_here"
MIDTRANS_SERVER_KEY="SB-Mid-server-your_server_key_here"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your_client_key_here"
MIDTRANS_IS_PRODUCTION="false"
